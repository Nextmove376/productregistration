{
  "name": "nextmove-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:admin": "node --experimental-strip-types scripts/create-admin.ts"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "isomorphic-dompurify": "2.16.0",
    "jose": "5.9.6",
    "lucide-react": "^1.26.0",
    "mysql2": "3.11.5",
    "next": "16.2.11",
    "nodemailer": "6.9.16",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "0.5.15",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
