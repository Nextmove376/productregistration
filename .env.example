# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Auth
AUTH_SECRET=

# Email (SMTP)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_TO=

# Cron
CRON_SECRET=

# Privacy
IP_SALT=

# Uploads
#
# Absolute path to the directory holding uploaded media. Leave blank to use
# `<project>/uploads`.
#
# SET THIS IN PRODUCTION. Uploaded files are user data, but `<project>/uploads`
# sits inside the directory the deploy replaces, so a deploy silently deletes the
# entire media library and every image on the site breaks at once. Point this at a
# directory OUTSIDE the deployed folder — e.g. a sibling of `domains/` — and it
# survives deploys.
#
# Check the resolved value at /admin/diagnostics -> Uploads directory.
UPLOAD_DIR_OVERRIDE=
